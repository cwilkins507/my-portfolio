---
import Navigation from '../components/Navigation.jsx';
import ContactModalWrapper from '../components/ContactModalWrapper';
import '../index.css';
import { SMB_ASSESSMENT, NEWSLETTER, ANALYTICS_EVENTS } from '../data/site.js';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	schema?: object | object[];
	hideFooterNewsletter?: boolean;
	robots?: string;
}

const {
	title,
	description = "Lead Software Engineer specializing in AI engineering, automation architecture, and production AI systems.",
	image,
	type = 'website',
	publishedTime,
	schema,
	hideFooterNewsletter = false,
	robots = 'index, follow',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname.toLowerCase().replace(/\.html$/, ''), Astro.site);
const imageURL = new URL(image || '/images/og-default.png', Astro.site);

const portfolioData = {
  name: "Collin Wilkins",
  email: "collin@collinwilkins.com",
  linkedin: "https://www.linkedin.com/in/collin-wilkins-1020215a/",
  github: "https://github.com/cwilkins507"
};

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="google-site-verification" content="p-TMFQiYQvWsK5Tn417NrhsVXZUOlO0riWjvgMm-zSI" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@CollinWilkins7" />
		<meta name="twitter:creator" content="@CollinWilkins7" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageURL} />

		<link rel="canonical" href={canonicalURL} />

		<!-- Google Fonts: Newsreader + IBM Plex Mono — async and optional to avoid render blocking and late layout shifts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=optional" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=IBM+Plex+Mono:wght@400;500&display=optional" rel="stylesheet" /></noscript>

		<!-- JSON-LD Structured Data -->
		{schema && (
			Array.isArray(schema) ? (
				schema.map((s) => (
					<script type="application/ld+json" set:html={JSON.stringify(s)} />
				))
			) : (
				<script type="application/ld+json" set:html={JSON.stringify(schema)} />
			)
		)}

		<!-- URL normalisation: strip .html, lowercase -->
		<script is:inline>
			(function(){
				var path = window.location.pathname;
				var canonical = path.replace(/\.html$/, '').toLowerCase();
				if (canonical !== path) {
					window.location.replace(canonical + window.location.search + window.location.hash);
				}
			})();
		</script>

		<!-- Plausible Analytics -->
		<script async src="https://plausible.io/js/pa-CmOP0LRtv6tlswXjVukB6.js"></script>
		<script>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script>
	</head>
	<body>
		<a class="skip-link" href="#page-content">Skip to content</a>
		<Navigation portfolioData={portfolioData} client:load />

		<main id="page-content" tabindex="-1">
			<slot />
		</main>

		<!-- Footer -->
		<footer style="border-top: 1px solid var(--rule);">
			<!-- Newsletter strip (footer-only) -->
			{!hideFooterNewsletter && (
				<div style="background: var(--paper-2); border-bottom: 1px solid var(--rule);">
					<div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-top:22px;padding-bottom:22px;">
						<p style="font-size:15px;line-height:1.5;color:var(--ink-soft);max-width:54ch;">
							<strong style="color:var(--ink);font-weight:600;">{NEWSLETTER.name}.</strong> {NEWSLETTER.promise}
						</p>
						<form
							action={NEWSLETTER.subscribeAction}
							method="post"
							target="popupwindow"
							data-newsletter-event={ANALYTICS_EVENTS.newsletterSubscribe}
							data-location="footer"
							style="display:flex;gap:10px;flex-shrink:0;"
						>
							<input
								type="email"
								name="email"
								placeholder="you@company.com"
								aria-label="Email address"
								required
								style="border:1px solid var(--rule);border-radius:999px;padding:11px 18px;background:var(--paper);font-family:var(--mono);font-size:13px;color:var(--ink);width:min(220px,55vw);outline:none;"
							/>
							<button type="submit" class="btn btn-ghost">Subscribe</button>
						</form>
					</div>
				</div>
			)}

			<!-- 4-column footer links -->
			<div class="footer-grid" style={`max-width:var(--maxw);margin:0 auto;padding:clamp(36px,5vw,52px) clamp(20px,5vw,48px) 0;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:24px;`}>
				<div>
					<div style="font-size:18px;font-weight:600;letter-spacing:-.01em;">{portfolioData.name}</div>
					<p style="font-size:13.5px;line-height:1.5;color:var(--ink-soft);max-width:32ch;margin-top:10px;">
						Practical workflow automation for owner-operated teams, grounded in engineering evidence.
					</p>
				</div>
				<div>
					<h2 style="font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:15px;">Work</h2>
					<ul style="list-style:none;">
						<li><a class="footer-link" href={SMB_ASSESSMENT.slug} data-analytics-event={ANALYTICS_EVENTS.smbAssessmentOpen} data-analytics-location="footer-work-assessment">Workflow assessment</a></li>
						<li><a class="footer-link" href="/services">All services</a></li>
						<li><a class="footer-link" href="/contact">Contact form</a></li>
					</ul>
				</div>
				<div>
					<h2 style="font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:15px;">Writing</h2>
					<ul style="list-style:none;">
						<li><a class="footer-link" href="/articles">Articles</a></li>
						<li><a class="footer-link" href="/faq">FAQ</a></li>
						<li><a class="footer-link" href="/resources">Free resources</a></li>
						<li><a class="footer-link" href={NEWSLETTER.archiveHref} target="_blank" rel="noopener noreferrer">{NEWSLETTER.name}</a></li>
					</ul>
				</div>
				<div>
					<h2 style="font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:15px;">Elsewhere</h2>
					<ul style="list-style:none;">
						<li><a class="footer-link" href={portfolioData.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
						<li><a class="footer-link" href={portfolioData.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
						<li><a class="footer-link" href="https://x.com/CollinWilkins7" target="_blank" rel="noopener noreferrer">Twitter / X</a></li>
					</ul>
				</div>
			</div>

			<div style={`max-width:var(--maxw);margin:0 auto;padding:28px clamp(20px,5vw,48px) 20px;font-family:var(--mono);font-size:11px;color:var(--ink-faint);letter-spacing:.04em;`}>
				© {currentYear} Collin Wilkins · Detroit, MI
			</div>
		</footer>

		<!-- Contact Modal -->
		<ContactModalWrapper email={portfolioData.email} client:only="react" />
		<script is:inline>document.addEventListener('submit',function(event){var form=event.target.closest('[data-newsletter-event]');if(form&&window.plausible)window.plausible(form.dataset.newsletterEvent,{props:{location:form.dataset.location,measurement:'intent'}});});</script>
		<script is:inline>document.addEventListener('click',function(event){var link=event.target.closest('[data-analytics-event][data-analytics-location]');if(link&&window.plausible)window.plausible(link.dataset.analyticsEvent,{props:{location:link.dataset.analyticsLocation}});});</script>
</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 100;
		transform: translateY(-160%);
		border: 1px solid var(--ink);
		padding: 10px 16px;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 11px;
		text-decoration: none;
	}

	.skip-link:focus {
		transform: translateY(0);
	}
	.footer-link {
		display: flex;
		min-height: 44px;
		align-items: center;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: .02em;
		text-decoration: none;
	}

	.footer-link:hover {
		color: var(--accent);
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr !important;
		}
	}
</style>
