---
import Layout from '../layouts/Layout.astro';
import About from '../components/About';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Collin Wilkins",
  "jobTitle": "Software Engineer",
  "description": "Software engineer and technical leader focused on distributed systems, infrastructure, developer tooling, and AI-native software development.",
  "url": "https://collinwilkins.com",
  "sameAs": [
    "https://github.com/cwilkins507",
    "https://x.com/CollinWilkins7"
  ],
  "knowsAbout": [
    "Python",
    "AWS",
    "Serverless Architecture",
    "AI Integration",
    "AI Coding Tools",
    "Claude Code",
    "Convention Files",
    "Context Engineering",
    "Automation",
    "Automation Architecture",
    "Event-Driven Systems",
    "Software Architecture"
  ]
};
---

<Layout
  title="About | Collin Wilkins"
  description="Software engineer and technical leader focused on distributed systems, infrastructure, developer tooling, and AI-native software development."
  schema={personSchema}
>
	<About />
</Layout>
