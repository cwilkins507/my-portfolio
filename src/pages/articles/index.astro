---
import Layout from '../../layouts/Layout.astro';
import AskBlog from '../../components/AskBlog';
import { CATEGORIES } from '../../data/categories.js';
import { articleFromModule } from '../../utils/articleData.js';
import { buildSearchDocuments } from '../../utils/buildSearchDocuments.js';

const articleModules = import.meta.glob('../../articles/*.md', { eager: true });
const articles = Object.entries(articleModules).map(([file, article]) => articleFromModule(file, article))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const searchDocuments = buildSearchDocuments(articles);

const totalArticles = articles.length;
const featured = articles[0];
const rest = articles.slice(1);

const categoryNames = ['All', ...Object.keys(CATEGORIES)];

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Articles — Collin Wilkins',
  description: 'Long-form articles on AI engineering, automation architecture, and production software from a Lead Software Engineer.',
  url: 'https://collinwilkins.com/articles',
  author: { '@type': 'Person', name: 'Collin Wilkins', url: 'https://collinwilkins.com' },
  hasPart: articles.slice(0, 10).map(a => ({
    '@type': 'Article',
    headline: a.title,
    url: `https://collinwilkins.com/articles/${a.slug}`,
    datePublished: a.date,
  })),
};
---

<Layout
  title="Articles — AI Engineering, Automation Architecture | Collin Wilkins"
  description="Long-form articles on AI engineering, automation architecture, and production software from a Lead Software Engineer at Morningstar."
  schema={collectionSchema}
>

<div style="padding:clamp(52px,7vw,84px) 0 0;">
  <div class="wrap">
    <!-- Page header -->
    <header class="archive-header">
      <h1>Articles</h1>
      <p>
        {totalArticles} field notes on AI engineering, automation architecture, and production software—ordered as a working record, not a content feed.
      </p>
    </header>

    <!-- Category filter chips -->
    <div id="filter-bar" aria-label="Filter articles by category" style="display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-start;margin-top:clamp(32px,4vw,48px);">
      {categoryNames.map(cat => (
        <button
          class="filter-chip"
          data-cat={cat}
          aria-pressed="false"
          style="min-height:44px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:10px 16px;border-radius:999px;border:1px solid var(--rule);background:none;color:var(--ink-soft);cursor:pointer;transition:.15s;"
        >
          {cat}
        </button>
      ))}
    </div>
    <div class="archive-search">
      <AskBlog compact documents={searchDocuments} articleCount={totalArticles} client:load />
      <p class="archive-help">Prefer prepared answers? <a href="/faq">Open the public FAQ →</a></p>
    </div>
  </div>

  <!-- Featured article -->
  <div class="wrap" style="margin-top:clamp(40px,5vw,60px);">
    <a
      id="featured-card"
      href={`/articles/${featured.slug}`}
      data-cat={featured.category}
      style="display:grid;grid-template-columns:1fr;border:1px solid var(--rule);overflow:hidden;text-decoration:none;color:var(--ink);transition:background .15s;background:var(--paper);"
      onmouseover="this.style.background='var(--paper-2)'"
      onmouseout="this.style.background='var(--paper)'"
    >
      {featured.image ? (
        <img src={featured.image} alt={featured.image_alt || featured.title} style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block;" loading="eager" />
      ) : (
        <div class="ph" style="aspect-ratio:16/9;"><span>Featured cover</span></div>
      )}
      <div style="padding:clamp(24px,3vw,36px);">
        <div style="display:flex;gap:14px;align-items:center;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px;">
          <span style="color:var(--accent-text);">{featured.category}</span>
          <span style="color:var(--ink-faint);">{formatDate(featured.date)}</span>
        </div>
        <h2 style="font-size:clamp(24px,3.6vw,38px);font-weight:500;line-height:1.1;letter-spacing:-.015em;">{featured.title}</h2>
        <p style="font-size:17px;line-height:1.5;color:var(--ink-soft);margin-top:14px;max-width:60ch;">{featured.excerpt}</p>
        <span style="font-family:var(--mono);font-size:11px;letter-spacing:.05em;color:var(--ink);display:inline-block;margin-top:22px;">Read →</span>
      </div>
    </a>
  </div>

  <!-- Dense article list -->
  <section class="wrap archive-register" aria-labelledby="archive-register-title">
    <div class="archive-register-heading">
      <h2 id="archive-register-title">The full register</h2>
      <p id="filter-status" aria-live="polite">{totalArticles} articles, newest first</p>
    </div>
    <ul id="article-list">
      {rest.map(article => (
        <li data-cat={article.category}>
          <a
            href={`/articles/${article.slug}`}
            class="article-row"
          >
            <span class="row-cat">{article.category}</span>
            <span class="row-title">{article.title}</span>
            <span class="row-date">{formatDate(article.date)}</span>
          </a>
        </li>
      ))}
    </ul>

    <div id="empty-state" hidden>
      <p>No articles match this category.</p>
      <button id="clear-filter" type="button">Show all articles</button>
    </div>
  </section>
</div>

</Layout>

<style>
.archive-header {
  max-width: 50rem;
  border-top: 1px solid var(--ink);
  padding-top: clamp(20px, 3vw, 32px);
}
.archive-header h1 {
  max-width: 8ch;
  font-size: clamp(40px, 6vw, 64px);
  font-weight: 500;
  letter-spacing: -.02em;
  line-height: 1.04;
}
.archive-header p {
  max-width: 58ch;
  margin-top: 18px;
  color: var(--ink-soft);
  font-size: 21px;
  line-height: 1.55;
  text-wrap: pretty;
}
.archive-search {
  margin-top: clamp(32px, 5vw, 56px);
  padding: clamp(24px, 4vw, 42px) 0;
  border-block: 1px solid var(--rule);
}
.archive-help {
  margin-top: 20px;
  color: var(--ink-faint);
  font-family: var(--mono);
  font-size: 11px;
}
.archive-register {
  margin-top: clamp(32px, 4vw, 48px);
  padding-bottom: clamp(52px, 7vw, 84px);
}
.archive-register-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 16px;
}
.archive-register-heading h2 {
  font-size: clamp(30px, 4.8vw, 54px);
  font-weight: 500;
  line-height: 1.02;
}
.archive-register-heading p {
  color: var(--ink-faint);
  font-family: var(--mono);
  font-size: 11px;
}
#empty-state {
  padding: 40px 0;
  color: var(--ink-soft);
}
#empty-state button {
  min-height: 44px;
  margin-top: 12px;
  border: 1px solid var(--rule);
  border-radius: 999px;
  padding: 10px 16px;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  font-family: var(--mono);
  font-size: 11px;
}
#article-list,
#article-list > li {
  margin: 0;
  padding: 0;
  list-style: none;
}
#featured-card[hidden] {
  display: none !important;
}
.article-row {
  display: grid;
  grid-template-columns: 160px 1fr auto;
  gap: clamp(16px, 2.5vw, 32px);
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid var(--rule);
  text-decoration: none;
  color: var(--ink);
  transition: background .12s;
}
.article-row:hover { background: var(--paper-2); }
.article-row:hover .row-title { color: var(--accent); }

.row-cat {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--accent-text);
  background: var(--paper-2);
  border: 1px solid var(--rule);
  border-radius: 999px;
  padding: 4px 10px;
  white-space: nowrap;
  justify-self: start;
}
.article-row:hover .row-cat {
  background: var(--paper-3);
  border-color: var(--ink-faint);
}

.row-title {
  font-size: 16px;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -.01em;
  transition: color .12s;
}

.row-date {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-faint);
  white-space: nowrap;
}

#article-list { border-top: 1px solid var(--rule); }

@media (max-width: 620px) {
  .article-row {
    grid-template-columns: 1fr auto;
    gap: 6px 12px;
    padding: 16px 0;
  }
  .row-cat { grid-column: 1 / -1; }
  .row-title { font-size: 16px; }
  .row-date { align-self: start; }
  .archive-register-heading {
    align-items: start;
    flex-direction: column;
    gap: 8px;
  }
}
</style>

<script define:vars={{ categoryNames }}>
  const chips = document.querySelectorAll('.filter-chip');
  const clearFilter = document.getElementById('clear-filter');
  const featured = document.getElementById('featured-card');
  const empty = document.getElementById('empty-state');
  const status = document.getElementById('filter-status');
  const rows = document.querySelectorAll('#article-list li[data-cat]');

  // Read initial category from URL param; fall back to All for unknown values
  const params = new URLSearchParams(window.location.search);
  const rawCat = params.get('cat');
  let activeCat = (rawCat && categoryNames.includes(rawCat)) ? rawCat : 'All';

  function setActiveChip(cat) {
    chips.forEach(c => {
      const isActive = c.dataset.cat === cat;
      c.style.background = isActive ? 'var(--ink)' : 'none';
      c.style.color = isActive ? 'var(--paper)' : 'var(--ink-soft)';
      c.style.borderColor = isActive ? 'var(--ink)' : 'var(--rule)';
      c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function applyFilter(cat) {
    activeCat = cat;
    setActiveChip(cat);

    // Update URL without reload
    const url = new URL(window.location.href);
    if (cat === 'All') url.searchParams.delete('cat');
    else url.searchParams.set('cat', cat);
    history.replaceState(null, '', url.toString());

    // Filter featured and article rows without changing their display mode
    if (featured) {
      const show = cat === 'All' || featured.dataset.cat === cat;
      featured.hidden = !show;
    }

    let visible = 0;
    rows.forEach(row => {
      const show = cat === 'All' || row.dataset.cat === cat;
      row.hidden = !show;
      if (show) visible++;
    });

    if (empty) empty.hidden = visible !== 0;
    const totalVisible = visible + (featured && !featured.hidden ? 1 : 0);
    if (status) status.textContent = `${totalVisible} ${totalVisible === 1 ? 'article' : 'articles'}${cat === 'All' ? ', newest first' : ` in ${cat}`}`;
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => applyFilter(chip.dataset.cat));
  });
  clearFilter?.addEventListener('click', () => applyFilter('All'));

  // Apply on load
  applyFilter(activeCat);
</script>
