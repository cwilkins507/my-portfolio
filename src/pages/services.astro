---
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services';

const servicesSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": "AI Workflow Assessment & Engineering Pilot | Collin Wilkins",
	"description": "Two fixed-scope AI consulting paths: a $99 workflow assessment for owners and a $1,500 AI-Assisted Delivery Pilot for engineering teams.",
	"url": "https://collinwilkins.com/services",
	"provider": {
		"@type": "Person",
		"name": "Collin Wilkins",
		"url": "https://collinwilkins.com/about"
	},
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "AI workflow consulting",
		"itemListElement": [
			{
				"@type": "Offer",
				"price": "99",
				"priceCurrency": "USD",
				"url": "https://cal.com/collinwilkins/assessment",
				"itemOffered": {
					"@type": "Service",
					"name": "AI Workflow Opportunity Assessment",
					"description": "A 60-minute working session on one recurring workflow, followed within 48 hours by a Workflow Opportunity Map with up to three ranked opportunities, one recommended first system, and a 14-day action plan."
				}
			},
			{
				"@type": "Offer",
				"price": "1500",
				"priceCurrency": "USD",
				"url": "https://collinwilkins.com/services?modal=contact&service=ai-delivery-pilot",
				"itemOffered": {
					"@type": "Service",
					"name": "AI-Assisted Delivery Pilot",
					"description": "A five-business-day, fixed-scope installation of a governed AI-assisted delivery path in one repository, proven on one approved low-risk issue. The $1,500 founding price is split into $500 after scope acceptance and $1,000 after acceptance passes."
				}
			}
		]
	}
};

const servicesFaqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "What's the AI Workflow Opportunity Assessment?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "A focused 60-minute working session on one recurring workflow. Within 48 hours you receive a Workflow Opportunity Map with up to three ranked opportunities, one recommended first system, a 14-day action plan, and clear self-serve or implementation paths."
			}
		},
		{
			"@type": "Question",
			"name": "What's included in the AI-Assisted Delivery Pilot?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "One team, one repository, one intake system, one coding-agent adapter, and one approved low-risk issue. The customer receives repository-specific rules, protected-path controls, versioned model configuration, five smoke cases, a verified draft pull request, and a working handoff. The $1,500 founding price is $500 after scope acceptance and $1,000 only after acceptance passes."
			}
		},
		{
			"@type": "Question",
			"name": "Do you build general-purpose AI employees?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "No. The goal is the minimum reliable system for one business outcome, with limited integrations, explicit authority, observable execution, and a handoff the customer can operate."
			}
		},
		{
			"@type": "Question",
			"name": "What kinds of workflows are a fit?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Recurring workflows that waste time, delay follow-up, create reporting burden, or cause inconsistent execution. Financial-services engagements are excluded because of a conflict with my current employer."
			}
		}
	]
};
---

<Layout
	title="AI Workflow Assessment & Engineering Pilot | Collin Wilkins"
	description="Two fixed-scope AI consulting paths: a $99 workflow assessment for owners and a $1,500 AI-Assisted Delivery Pilot for engineering teams."
	schema={[servicesSchema, servicesFaqSchema]}
>
	<Services />
</Layout>
<style>.services{max-width:940px;padding-top:clamp(90px,12vw,150px);padding-bottom:100px}.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text)}h1{font-size:clamp(44px,7vw,78px);line-height:.97;margin:16px 0}.lede{font-size:clamp(20px,2.5vw,28px);color:var(--ink-soft)}.primary,aside{margin-top:55px;padding:40px;border:1px solid var(--rule)}.primary{background:var(--paper-2);border-top:4px solid var(--accent)}h2{font-size:clamp(30px,4vw,48px)}.contract{font-family:var(--mono)}.actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:25px}aside h2{font-size:30px}aside p{color:var(--ink-soft)}@media(max-width:640px){.primary,aside{padding:26px}}</style>
