---
import Layout from '../layouts/Layout.astro';
import { ADVISORY } from '../data/site.js';

const advisorySchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Advisory & Consulting',
	description: ADVISORY.statusLine,
	url: 'https://collinwilkins.com/services',
	author: {
		'@type': 'Person',
		name: 'Collin Wilkins',
		url: 'https://collinwilkins.com/about',
	},
};
---

<Layout
	title="Advisory & Consulting | Collin Wilkins"
	description="Notes on the kinds of engineering problems I've worked on. Not currently accepting new client engagements."
	schema={advisorySchema}
	hideFooterNewsletter={true}
>
  <article class="wrap advisory">
    <header>
      <p class="eyebrow">Reference</p>
      <h1>Advisory &amp; Consulting</h1>
      <p class="lede">{ADVISORY.lead}</p>
    </header>

    <aside class="status" aria-labelledby="status-title">
      <p class="status__line" id="status-title">{ADVISORY.statusLine}</p>
      <p class="status__note">{ADVISORY.note}</p>
    </aside>

    <section aria-labelledby="topics-title">
      <h2 id="topics-title">The kinds of problems</h2>
      <ul class="topics">
        {ADVISORY.topics.map(topic => (
          <li>
            <h3>{topic.name}</h3>
            <p>{topic.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <footer class="close">
      <a class="action-link" href="/articles">Read the writing →</a>
      <p class="close__note">For writing, technical discussions, collaborations, or other inquiries, <a href="/connect">email is the fastest path</a>.</p>
    </footer>
  </article>
</Layout>

<style>
  .advisory {
    max-width: 840px;
    padding-top: clamp(58px, 8vw, 96px);
    padding-bottom: 100px;
  }

  .eyebrow {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 20ch;
    margin: 16px 0;
    font-size: clamp(42px, 5.4vw, 64px);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: .96;
  }

  .lede {
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.45;
  }

  .status {
    margin-top: clamp(40px, 6vw, 60px);
    padding: clamp(22px, 3.5vw, 32px);
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .status__line {
    margin: 0;
    font-size: 20px;
    line-height: 1.4;
  }

  .status__note {
    max-width: 60ch;
    margin: 10px 0 0;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.55;
  }

  section {
    margin-top: clamp(56px, 8vw, 88px);
    padding-top: clamp(34px, 5vw, 48px);
    border-top: 1px solid var(--rule);
  }

  h2 {
    max-width: 24ch;
    margin: 0 0 8px;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.05;
  }

  .topics {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics li {
    padding-block: 24px;
    border-bottom: 1px solid var(--rule);
  }

  .topics h3 {
    max-width: 28ch;
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }

  .topics p {
    max-width: 66ch;
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.55;
  }

  .close {
    display: grid;
    gap: 8px;
    margin-top: clamp(40px, 6vw, 60px);
  }

  .action-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-self: start;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .action-link:hover,
  .action-link:focus-visible {
    text-decoration-thickness: 2px;
  }

  .close__note {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-faint);
    font-size: 16px;
    line-height: 1.6;
  }

  .close__note a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .topics li {
      padding-block: 20px;
    }
  }
</style>
