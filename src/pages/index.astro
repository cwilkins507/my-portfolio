---
import Layout from '../layouts/Layout.astro';
import { NEWSLETTER, ANALYTICS_EVENTS, PUBLIC_CONTACT_PROFILE } from '../data/site.js';
import { CATEGORIES } from '../data/categories.js';
import { articleFromModule } from '../utils/articleData.js';

const pageTitle = 'Collin Wilkins — Software Engineering, Systems, and AI-Native Development';
const pageDescription = 'Essays and field notes on software engineering, distributed systems, infrastructure, developer tooling, and AI-native development.';

const articleModules = import.meta.glob('../articles/*.md', { eager: true });
const articles = Object.entries(articleModules)
  .map(([file, article]) => articleFromModule(file, article))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const latest = articles.slice(0, 4);
const [lead, ...rest] = latest;

const topicCounts = Object.keys(CATEGORIES).map(name => ({
  name,
  href: `/articles?cat=${encodeURIComponent(name)}`,
  count: articles.filter(article => article.category === name).length,
})).filter(topic => topic.count > 0);

const projects = [
  {
    name: 'Agent Harness Builder',
    kind: 'Tool',
    description: 'Generates the repository scaffolding a coding agent needs to be useful: conventions, protected paths, verification hooks, and a reviewable change path.',
    href: '/resources/agent-harness-builder',
  },
  {
    name: 'Ask the archive',
    kind: 'Experiment',
    description: 'Retrieval over every article on this site — a small Python RAG service with its own corpus, rate limiting, and evaluation harness.',
    href: '/ask',
  },
  {
    name: 'AI Prompt Toolkit',
    kind: 'Resource',
    description: 'The prompts I actually reuse for engineering work, written out in full rather than summarized.',
    href: '/resources/ai-prompt-toolkit',
  },
  {
    name: 'FiNimbus',
    kind: 'Product',
    description: 'A founder-owned financial software project, built and operated outside of any employer. Written up from the inside: automating its signup flow over a weekend.',
    href: '/articles/automate-saas-signup-flow-weekend',
  },
];

const formatDate = (value) =>
  new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Collin Wilkins',
    url: 'https://collinwilkins.com',
    description: pageDescription,
    author: {
      '@type': 'Person',
      name: 'Collin Wilkins',
      jobTitle: 'Software Engineer',
      url: 'https://collinwilkins.com/about',
      sameAs: [PUBLIC_CONTACT_PROFILE.github, PUBLIC_CONTACT_PROFILE.x],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: NEWSLETTER.name,
    url: 'https://collinwilkins.com/articles',
    description: pageDescription,
    blogPost: latest.map(article => ({
      '@type': 'BlogPosting',
      headline: article.title,
      url: `https://collinwilkins.com/articles/${article.slug}`,
      datePublished: article.date,
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={homepageSchema} hideFooterNewsletter={true}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <p class="eyebrow">Essays &amp; field notes</p>
      <h1 id="hero-title">Collin Wilkins</h1>
      <p class="hero-lede">
        Software engineer and technical leader. I write about distributed and event-driven systems,
        infrastructure, developer tooling, and what AI-native development looks like once it has to
        survive production, review, and the people who maintain it.
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="/articles">Read the latest <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#subscribe">Subscribe to the newsletter</a>
      </div>
    </div>
  </section>

  <section class="band latest" aria-labelledby="latest-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="latest-title">Latest writing</h2>
        <a class="section-link" href="/articles">All articles <span aria-hidden="true">→</span></a>
      </div>

      <a class="lead-article" href={`/articles/${lead.slug}`}>
        <figure class="lead-figure">
          {lead.image ? (
            <img
              src={lead.image}
              alt={lead.image_alt || ''}
              width="1600"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <div class="ph"><span>{lead.category}</span></div>
          )}
        </figure>
        <div class="lead-copy">
          <span class="article-meta">
            <span class="article-cat">{lead.category}</span>
            <span class="article-date">{formatDate(lead.date)}</span>
            <span class="article-flag">Newest</span>
          </span>
          <h3 class="lead-title">{lead.title}</h3>
          <p class="lead-dek">{lead.excerpt}</p>
          <span class="lead-cue">Read the essay <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <ol class="article-list">
        {rest.map((article, index) => (
          <li>
            <a href={`/articles/${article.slug}`}>
              <span class="article-index" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
              <span class="article-body">
                <span class="article-meta">
                  <span class="article-cat">{article.category}</span>
                  <span class="article-date">{formatDate(article.date)}</span>
                </span>
                <span class="article-title">{article.title}</span>
                <span class="article-dek">{article.excerpt}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band topics" aria-labelledby="topics-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="topics-title">By topic</h2>
        <p class="section-note">The archive, sorted by the part of the stack it argues about.</p>
      </div>
      <ul class="topic-grid">
        {topicCounts.map(topic => (
          <li>
            <a href={topic.href}>
              <span class="topic-name">{topic.name}</span>
              <span class="topic-count">{topic.count} {topic.count === 1 ? 'article' : 'articles'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="subscribe" class="band subscribe" aria-labelledby="subscribe-title">
    <div class="wrap subscribe-inner">
      <div>
        <p class="eyebrow">{NEWSLETTER.name}</p>
        <h2 id="subscribe-title">One letter, every other Tuesday.</h2>
        <p class="subscribe-promise">{NEWSLETTER.promise}</p>
      </div>
      <div class="subscribe-form-col">
        <form
          action={NEWSLETTER.subscribeAction}
          method="post"
          target="popupwindow"
          data-newsletter-event={ANALYTICS_EVENTS.newsletterSubscribe}
          data-location="homepage"
          class="subscribe-form"
        >
          <label class="sr-only" for="homepage-newsletter-email">Email address</label>
          <input
            id="homepage-newsletter-email"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="btn btn-solid">Subscribe</button>
        </form>
        <p class="subscribe-note">
          <a href={NEWSLETTER.archiveHref} target="_blank" rel="noopener noreferrer">Read past issues</a> first. Unsubscribe whenever.
        </p>
      </div>
    </div>
  </section>

  <section class="band projects" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-title">Projects &amp; experiments</h2>
      </div>
      <ul class="project-grid">
        {projects.map(project => (
          <li>
            <a href={project.href}>
              <span class="project-kind">{project.kind}</span>
              <span class="project-name">{project.name}</span>
              <span class="project-desc">{project.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band background" aria-labelledby="background-title">
    <div class="wrap background-inner">
      <h2 id="background-title">Why I write about the unglamorous parts.</h2>
      <div class="background-copy">
        <p>
          My work centers on distributed and event-driven systems, cloud infrastructure, and the
          developer tooling that decides whether a team can change its own software safely. Most of
          what I publish starts as something I had to figure out anyway — a system that behaved
          strangely under load, a workflow that only worked because one person remembered the trick,
          an agent that looked productive until someone reviewed the diff.
        </p>
        <p>
          I came to engineering by way of finance, pricing, and operations, which is why I still start
          with the boring numbers before the architecture diagram. <a href="/about">More about me →</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner {
    padding-top: clamp(64px, 9vw, 132px);
    padding-bottom: clamp(52px, 7vw, 96px);
    max-width: 62rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  h1 {
    margin-top: 20px;
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -.022em;
    text-wrap: balance;
  }

  .hero-lede {
    margin-top: 22px;
    max-width: 46ch;
    font-size: clamp(18px, 2.1vw, 22px);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .band {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(48px, 6.5vw, 84px);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.018em;
  }

  .section-link,
  .section-note {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .06em;
    color: var(--ink-faint);
    text-decoration: none;
    max-width: 40ch;
  }

  .section-link {
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .section-link:hover {
    color: var(--accent-text);
  }

  /* ── Lead article ── */
  .lead-article {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 3.4vw, 48px);
    align-items: center;
    padding: clamp(28px, 3.6vw, 44px) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .lead-figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .lead-figure img,
  .lead-figure .ph {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform .4s cubic-bezier(.2, .7, .3, 1);
  }

  .lead-article:hover .lead-figure img {
    transform: scale(1.02);
  }

  .article-flag {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
  }

  .lead-title {
    margin-top: 14px;
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .lead-article:hover .lead-title {
    color: var(--accent-text);
  }

  .lead-dek {
    margin-top: 14px;
    max-width: 46ch;
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .lead-cue {
    display: inline-flex;
    gap: 7px;
    min-height: 44px;
    align-items: center;
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-figure img { transition: none; }
    .lead-article:hover .lead-figure img { transform: none; }
  }

  @media (max-width: 860px) {
    .lead-article {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  /* ── Latest writing ── */
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-list li + li {
    border-top: 1px solid var(--rule);
  }

  .article-list a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 8px;
    padding: clamp(22px, 3vw, 32px) 0;
    text-decoration: none;
    color: var(--ink);
    transition: background .15s;
  }

  .article-list a:hover {
    background: var(--paper-2);
  }

  .article-index {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--ink-faint);
    padding-top: 6px;
  }

  .article-body {
    display: block;
    max-width: 64ch;
  }

  .article-meta {
    display: flex;
    gap: 14px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .article-cat { color: var(--accent-text); }
  .article-date { color: var(--ink-faint); }

  .article-title {
    display: block;
    margin-top: 12px;
    font-size: clamp(22px, 2.6vw, 29px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -.015em;
    text-wrap: balance;
  }

  .article-list a:hover .article-title { color: var(--accent-text); }

  .article-dek {
    display: block;
    margin-top: 10px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* ── Topics ── */
  .topic-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .topic-grid li {
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
  }

  .topic-grid a {
    display: flex;
    min-height: 96px;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 24px clamp(16px, 2vw, 26px);
    text-decoration: none;
    color: var(--ink);
    transition: background .15s;
  }

  .topic-grid a:hover { background: var(--paper-2); }

  .topic-name {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  .topic-count {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ── Subscribe ── */
  .subscribe {
    background: var(--paper-2);
  }

  .subscribe-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .subscribe h2 {
    margin-top: 16px;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.018em;
  }

  .subscribe-promise {
    margin-top: 14px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .subscribe-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .subscribe-form input {
    flex: 1 1 200px;
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 12px 18px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
  }

  .subscribe-form input:focus-visible {
    border-color: var(--ink);
  }

  .subscribe-note {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--ink-faint);
  }

  .subscribe-note a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Projects ── */
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    border-left: 1px solid var(--rule);
  }

  .project-grid li {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .project-grid a {
    display: block;
    height: 100%;
    padding: clamp(20px, 2.4vw, 28px);
    text-decoration: none;
    color: var(--ink);
    transition: background .15s;
  }

  .project-grid a:hover { background: var(--paper-2); }

  .project-kind {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .project-name {
    display: block;
    margin-top: 12px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -.012em;
  }

  .project-desc {
    display: block;
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* ── Background ── */
  .background {
    border-bottom: none;
  }

  .background-inner {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .background h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -.018em;
    text-wrap: balance;
  }

  .background-copy p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .background-copy p + p { margin-top: 18px; }

  .background-copy a {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .subscribe-inner,
    .background-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .article-list a {
      grid-template-columns: 1fr;
    }

    .article-index { display: none; }
  }
</style>
