---
import Layout from '../layouts/Layout.astro';
import { CONSULTING_OVERVIEW, ENGINEERING_PILOT, INTRO_CALL, SMB_QUIZ, NEWSLETTER, ANALYTICS_EVENTS } from '../data/site.js';

const pageTitle = 'AI Systems and Automation Consulting | Collin Wilkins';
const pageDescription = 'I help business owners and engineering leaders turn AI experiments and manual workflows into maintainable backend systems, automation, and governed delivery paths.';

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Collin Wilkins',
    url: 'https://collinwilkins.com',
    description: pageDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: ENGINEERING_PILOT.name,
    description: ENGINEERING_PILOT.description,
    url: `https://collinwilkins.com${ENGINEERING_PILOT.slug}`,
    provider: {
      '@type': 'Person',
      name: 'Collin Wilkins',
      jobTitle: 'Lead Software Engineer',
      url: 'https://collinwilkins.com/about',
    },
    offers: {
      '@type': 'Offer',
      price: ENGINEERING_PILOT.priceUsd,
      priceCurrency: 'USD',
      url: `https://collinwilkins.com${ENGINEERING_PILOT.intakeHref}`,
    },
  },
];

const proofItems = [
  {
    value: '450K+ vehicles',
    detail: 'Ford work associated with approximately $5M in annual savings.',
  },
  {
    value: '600K+ events/day',
    detail: 'Connected-vehicle systems operating at production scale.',
  },
  {
    value: '42% fewer defects',
    detail: 'A broader AI-adoption and delivery-hardening initiative also associated with approximately 20% shorter cycle time.',
  },
];


const pilotSteps = [
  {
    number: '01',
    label: 'Map',
    title: 'Confirm the outcome and readiness gate.',
    detail: 'Fix the issue, non-goals, protected paths, acceptance checks, access, verification baseline, and accountable reviewers in writing.',
  },
  {
    number: '02',
    label: 'Install',
    title: 'Install one customer-owned delivery contract.',
    detail: 'Connect structured intake, repository context, the bounded coding agent, existing CI, model usage, and human-only decisions.',
  },
  {
    number: '03',
    label: 'Prove',
    title: 'Prove it and hand it off.',
    detail: 'Run one approved issue to a verified draft PR, pass the agreed checks, and have a customer engineer run the documented path.',
  },
];

const faqItems = [
  {
    question: 'What exactly is accepted on business day five?',
    answer: 'The agreed repository assets are installed; protected paths fail closed; the existing verification path and five smoke cases pass; one approved issue reaches a verified draft pull request with usage evidence; and a customer engineer runs the documented non-production path without Collin driving.',
  },
  {
    question: 'When does the five-day clock start?',
    answer: 'After written scope, least-privilege access, one approved low-risk issue, a passing baseline, an authenticated coding agent, working CI and draft-PR path, a named technical owner and reviewer, the $500 first installment, and a confirmed start date are ready.',
  },
  {
    question: 'What if acceptance misses business day five?',
    answer: ENGINEERING_PILOT.riskReversal,
  },
  {
    question: 'What does “founding price” mean?',
    answer: ENGINEERING_PILOT.foundingBoundary,
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={homepageSchema} hideFooterNewsletter={true}>
  <section class="hero" data-homepage-hero aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <p class="eyebrow">AI systems, backend automation, and technical advisory</p>

      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Turn AI experiments and manual work into systems your team can run.</h1>
          <p class="hero-lede">
            {CONSULTING_OVERVIEW.lead} My bread and butter is backend systems and workflow automation: lead routing, quote workflows, knowledge systems, integrations, and bounded agents.
          </p>

          <div class="hero-actions">
            <a
              class="btn btn-solid hero-primary"
              href={INTRO_CALL.href}
              data-analytics-event={ANALYTICS_EVENTS.bookingPageOpen}
              data-analytics-location="homepage-hero-booking"
            >
              {INTRO_CALL.bookingLabel} <span aria-hidden="true">→</span>
            </a>
            <a class="hero-secondary" href="/services">
              See the four ways I can help
            </a>
          </div>

          <p class="hero-note">Bring one workflow, delivery bottleneck, or AI-adoption problem. No hard sell; we will decide whether there is a useful next step.</p>
        </div>

        <aside class="pilot-docket" aria-label="Featured pilot at a glance">
          <div class="docket-topline">
            <span>Featured engagement</span>
            <span>Fixed scope</span>
          </div>
          <p class="docket-name">AI-Assisted Delivery Pilot</p>
          <h2>One issue. A working delivery path.</h2>

          <dl class="docket-facts">
            <div>
              <dt>Scope</dt>
              <dd>One team · one repository · one real backlog item</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd>5 business days after readiness · async-first</dd>
            </div>
            <div>
              <dt>Payment</dt>
              <dd>$500 to start · $1,000 after acceptance</dd>
            </div>
            <div>
              <dt>Founding price</dt>
              <dd>$1,500 · first 3 accepted pilots</dd>
            </div>
          </dl>

          <ol class="docket-flow" aria-label="Simplified pilot flow">
            <li>Map</li>
            <li>Install</li>
            <li>Prove</li>
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section class="credibility-strip" aria-labelledby="credibility-title">
    <div class="wrap credibility-inner">
      <p id="credibility-title" class="credibility-label">Built &amp; shipped at</p>
      <div class="credibility-logos" role="list" aria-label="Organizations and products">
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/morningstar.svg" alt="Morningstar" class="credibility-logo" />
        </span>
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/ford.webp" alt="Ford Motor Company" class="credibility-logo credibility-ford" />
        </span>
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/finimbus.png" alt="FiNimbus" class="credibility-logo credibility-finimbus" />
        </span>
        <span class="credibility-mark credibility-connected" role="listitem">
          <span class="connected-icon" aria-hidden="true"></span>
          Connected Vehicle
        </span>
      </div>
      <p class="credibility-qualifier">Full-time employment and founder-owned product work, not consulting-client logos.</p>
    </div>
  </section>

  <section class="overview-section" id="services-overview" aria-labelledby="overview-title">
    <div class="wrap section-inner">
      <div class="section-intro">
        <p class="eyebrow">What I offer</p>
        <h2 id="overview-title">The 30-second overview.</h2>
        <p>{CONSULTING_OVERVIEW.background}</p>
      </div>

      <div class="offer-grid">
        {CONSULTING_OVERVIEW.paths.map(path => (
          <article>
            <p class="offer-label">{path.label}</p>
            <h3>{path.name}</h3>
            <p>{path.description}</p>
            <a
              href={path.href}
              data-analytics-event={path.analyticsEvent}
              data-analytics-location={`homepage-offer-${path.id}`}
            >
              {path.cta} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="problem-section" aria-labelledby="problem-title">
    <div class="wrap section-inner">
      <div class="section-intro">
        <p class="eyebrow">A useful referral</p>
        <h2 id="problem-title">Three sentences that should make you think of me.</h2>
        <p>I work with business owners and engineering leaders who can name a real workflow or delivery problem—not teams shopping for AI theater.</p>
      </div>

      <div class="symptom-grid">
        {CONSULTING_OVERVIEW.referralSignals.map(signal => (
          <article>
            <p class="symptom-label">{signal.label}</p>
            <h3>{signal.title}</h3>
            <p>{signal.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pilot-section" aria-labelledby="process-title">
    <div class="wrap section-inner">
      <div class="section-intro">
        <p class="eyebrow">How the pilot works</p>
        <h2 id="process-title">From one approved issue to a path the customer can run.</h2>
        <p>The pilot keeps your issue tracker, coding tool, CI, and deployment path. It installs and proves the missing operating contract around them in five business days after readiness.</p>
      </div>

      <div class="process-grid">
        {pilotSteps.map(step => (
          <article>
            <p class="step-number">{step.number} / {step.label}</p>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </article>
        ))}
      </div>

      <div class="section-actions">
        <a
          href={ENGINEERING_PILOT.slug}
          data-analytics-event={ANALYTICS_EVENTS.pilotCtaClick}
          data-analytics-location="homepage-process-complete-offer"
        >
          Read the complete offer →
        </a>
        <a
          href={ENGINEERING_PILOT.capabilityBriefHref}
          data-analytics-event={ANALYTICS_EVENTS.capabilityBriefView}
          data-analytics-location="homepage-process-capability-brief"
        >
          Open the one-page capability brief →
        </a>
      </div>
    </div>
  </section>

  <section class="proof-band" aria-labelledby="proof-title">
    <div class="wrap section-inner">
      <div class="section-intro">
        <p class="eyebrow">Qualified engineering proof</p>
        <h2 id="proof-title">Production experience behind a bounded pilot.</h2>
        <p>Relevant outcomes from full-time engineering roles, shown after the offer is clear—not before the buyer’s problem.</p>
      </div>

      <div class="proof-ledger">
        {proofItems.map(item => (
          <article>
            <strong>{item.value}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
      <p class="proof-qualifier">Full-time employment outcomes, not consulting-client results.</p>
    </div>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="wrap section-inner faq-layout">
      <div>
        <p class="eyebrow">Before the scope review</p>
        <h2 id="faq-title">The practical questions.</h2>
        <p class="faq-intro">Four operational terms fixed before the first installment.</p>
      </div>

      <div class="faq-list">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="close-section" aria-labelledby="close-title">
    <div class="wrap close-inner">
      <div>
        <p class="eyebrow">A free 30-minute first step</p>
        <h2 id="close-title">Bring one workflow. Leave with the right next step.</h2>
      </div>

      <div class="close-actions">
        <a
          class="btn btn-solid"
          href={INTRO_CALL.href}
          data-analytics-event={ANALYTICS_EVENTS.bookingPageOpen}
          data-analytics-location="homepage-final-booking"
        >
          {INTRO_CALL.bookingLabel} <span aria-hidden="true">→</span>
        </a>
        <a
          class="close-secondary"
          href={ENGINEERING_PILOT.intakeHref}
          data-analytics-event={ANALYTICS_EVENTS.pilotCtaClick}
          data-analytics-location="homepage-final-scope-review"
        >
          Already know you want the pilot? Request a scope review
        </a>
        <p class="close-note">We will choose the assessment, pilot, advisory, hands-on build, or no engagement based on the problem—not force every conversation into one offer.</p>
      </div>
    </div>
  </section>

  <section class="utility-section" aria-label="Secondary resources">
    <div class="wrap utility-grid">
      <article>
        <p class="eyebrow">Writing and tools</p>
        <a href="/articles">Practical guides for AI-assisted delivery →</a>
        <p>Articles and the Agent Harness Builder remain available without interrupting the offer.</p>
      </article>
      <article>
        <p class="eyebrow">{NEWSLETTER.name}</p>
        <a href="/newsletter">Get the next issue →</a>
        <p>{NEWSLETTER.promise}</p>
      </article>
      <article>
        <p class="eyebrow">Small-business automation</p>
        <a
          href={SMB_QUIZ.slug}
          data-analytics-event={ANALYTICS_EVENTS.smbQuizStart}
          data-analytics-location="homepage-footer-smb-quiz"
        >
          {SMB_QUIZ.ctaLabel} →
        </a>
        <p>Start here when the problem is operational drag rather than an engineering delivery path.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    margin: 0;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero,
  .credibility-strip,
  .overview-section,
  .problem-section,
  .pilot-section,
  .proof-band,
  .faq-section,
  .utility-section {
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner {
    padding-block: clamp(58px, 8vw, 96px);
  }

  .hero-inner > .eyebrow {
    max-width: 72ch;
    margin-bottom: clamp(22px, 3vw, 34px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, .82fr);
    gap: clamp(46px, 7vw, 88px);
    align-items: center;
  }

  .hero h1 {
    max-width: 10.8ch;
    margin: 0;
    font-size: clamp(52px, 6.6vw, 86px);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: .9;
    text-wrap: balance;
  }

  .hero h1 em {
    color: var(--accent-text);
    font-style: italic;
    font-weight: 500;
  }

  .hero-lede {
    max-width: 32rem;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: clamp(20px, 2vw, 25px);
    line-height: 1.38;
    text-wrap: pretty;
  }

  .hero-lede strong {
    color: var(--ink);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 28px;
  }

  .hero-primary {
    min-height: 46px;
    padding-inline: 20px;
    font-weight: 500;
  }

  .hero-secondary,
  .section-actions a,
  .close-secondary {
    font-family: var(--mono);
    font-size: 11px;
    text-underline-offset: 5px;
  }

  .hero-secondary,
  .section-actions a {
    color: var(--ink);
  }

  .hero-secondary:hover,
  .section-actions a:hover {
    color: var(--accent-text);
  }

  .hero-note {
    max-width: 48ch;
    margin-top: 18px;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.55;
  }

  .pilot-docket {
    position: relative;
    padding: clamp(26px, 3vw, 38px);
    border: 1px solid var(--ink);
    background: var(--paper-2);
    box-shadow: 12px 12px 0 var(--paper-3);
  }

  .pilot-docket::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 62px;
    height: 4px;
    background: var(--accent);
    content: '';
  }

  .docket-topline {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .docket-name {
    margin-top: 20px;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .pilot-docket h2 {
    max-width: 12ch;
    margin-top: 7px;
    font-size: clamp(31px, 3vw, 42px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: .98;
  }

  .docket-facts {
    margin-top: 23px;
    border-top: 1px solid var(--rule);
  }

  .docket-facts > div {
    display: grid;
    grid-template-columns: 75px 1fr;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--rule);
  }

  .docket-facts dt {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .docket-facts dd {
    color: var(--ink);
    font-size: 15px;
    line-height: 1.3;
  }

  .docket-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .docket-flow li {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 9px;
  }

  .docket-flow li:not(:last-child)::after {
    margin-left: 18px;
    color: var(--accent-text);
    content: '→';
  }

  .credibility-inner {
    padding-block: 27px 24px;
  }

  .credibility-label,
  .credibility-qualifier {
    margin: 0;
    text-align: center;
    font-family: var(--mono);
  }

  .credibility-label {
    margin-bottom: 18px;
    color: var(--accent-text);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .credibility-logos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 4vw, 58px);
    align-items: center;
  }

  .credibility-mark {
    display: flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    filter: grayscale(1) contrast(1.15);
    opacity: .82;
  }

  .credibility-logo {
    width: auto;
    max-width: 145px;
    height: 28px;
    object-fit: contain;
  }

  .credibility-ford {
    height: 34px;
  }

  .credibility-finimbus {
    height: 54px;
    mix-blend-mode: multiply;
  }

  .credibility-connected {
    gap: 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
  }

  .connected-icon {
    width: 14px;
    height: 14px;
    border: 1px dashed var(--accent-text);
    border-radius: 50%;
  }

  .credibility-qualifier {
    margin-top: 14px;
    color: var(--ink-faint);
    font-size: 8px;
    letter-spacing: .04em;
  }

  .section-inner {
    padding-block: clamp(66px, 9vw, 108px);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .78fr);
    gap: 24px clamp(42px, 7vw, 90px);
    align-items: end;
    margin-bottom: 42px;
  }

  .section-intro .eyebrow {
    grid-column: 1 / -1;
  }

  .section-intro h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(39px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: .96;
    text-wrap: balance;
  }

  .section-intro > p:last-child {
    margin: 0 0 4px;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .offer-grid article {
    display: flex;
    min-height: 285px;
    flex-direction: column;
    padding: clamp(24px, 3vw, 34px);
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .offer-label {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .offer-grid h3 {
    max-width: 18ch;
    margin-top: 28px;
    font-size: clamp(27px, 3vw, 36px);
    font-weight: 500;
    line-height: 1.03;
  }

  .offer-grid article > p:nth-of-type(2) {
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.5;
  }

  .offer-grid a {
    margin-top: auto;
    padding-top: 24px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    text-underline-offset: 5px;
  }

  .offer-grid a:hover {
    color: var(--accent-text);
  }

  .symptom-grid,
  .process-grid,
  .proof-ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .symptom-grid {
    border: 1px solid var(--rule);
  }

  .symptom-grid article {
    min-height: 235px;
    padding: clamp(24px, 3vw, 32px);
  }

  .symptom-grid article + article,
  .process-grid article + article,
  .proof-ledger article + article {
    border-left: 1px solid var(--rule);
  }

  .symptom-label,
  .step-number {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .symptom-grid h3 {
    margin-top: 44px;
    font-size: clamp(24px, 2.5vw, 31px);
    font-weight: 500;
    letter-spacing: -.015em;
    line-height: 1.05;
  }

  .symptom-grid article > p:last-child,
  .process-grid article > p:last-child,
  .proof-ledger p {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.45;
  }

  .symptom-grid article > p:last-child,
  .process-grid article > p:last-child {
    margin-top: 14px;
  }

  .pilot-section,
  .faq-section {
    background: var(--paper-2);
  }

  .process-grid {
    border-block: 1px solid var(--ink);
  }

  .process-grid article {
    padding: 30px clamp(22px, 3vw, 34px) 34px;
  }

  .process-grid h3 {
    margin-top: 52px;
    font-size: 29px;
    font-weight: 500;
    line-height: 1.05;
  }

  .section-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin-top: 30px;
  }

  .proof-ledger {
    border-block: 1px solid var(--ink);
  }

  .proof-ledger article {
    min-height: 180px;
    padding: 26px clamp(22px, 3vw, 34px);
  }

  .proof-ledger strong {
    display: block;
    color: var(--ink);
    font-size: clamp(27px, 3vw, 37px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1;
  }

  .proof-ledger p {
