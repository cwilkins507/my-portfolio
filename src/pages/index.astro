---
import Layout from '../layouts/Layout.astro';
import { INTRO_CALL, SMB_ASSESSMENT, SMB_QUIZ, NEWSLETTER, ANALYTICS_EVENTS } from '../data/site.js';

const pageTitle = 'AI Workflow Assessment for Small Teams | Collin Wilkins';
const pageDescription = 'I help owner-operators choose the first recurring workflow worth improving, then leave with ranked opportunities and a practical 14-day plan.';

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Collin Wilkins',
    url: 'https://collinwilkins.com',
    description: pageDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: SMB_ASSESSMENT.name,
    description: SMB_ASSESSMENT.description,
    url: `https://collinwilkins.com${SMB_ASSESSMENT.slug}`,
    provider: {
      '@type': 'Person',
      name: 'Collin Wilkins',
      jobTitle: 'Lead Software Engineer',
      url: 'https://collinwilkins.com/about',
    },
    offers: {
      '@type': 'Offer',
      price: SMB_ASSESSMENT.priceUsd,
      priceCurrency: 'USD',
      url: `https://collinwilkins.com${SMB_ASSESSMENT.slug}`,
    },
  },
];

const proofItems = [
  {
    value: '450K+ vehicles',
    detail: 'Ford work associated with approximately $5M in annual savings.',
  },
  {
    value: '600K+ events/day',
    detail: 'Connected-vehicle systems operating at production scale.',
  },
  {
    value: '42% fewer defects',
    detail: 'A broader AI-adoption and delivery-hardening initiative also associated with approximately 20% shorter cycle time.',
  },
];



const faqItems = [
  {
    question: 'Who is the assessment for?',
    answer: 'Owner-operators of non-financial-services small teams with one recurring workflow that wastes time, delays customers, or depends too heavily on manual handoffs. Financial-services businesses are not eligible.',
  },
  {
    question: 'What happens after the free introduction?',
    answer: 'If the workflow is a good fit, we can book a separate 60-minute AI Workflow Opportunity Assessment for $99. The introduction is a no-pressure conversation, not a commitment to the assessment.',
  },
  {
    question: 'What do I receive?',
    answer: 'Within 48 hours, you receive a concise Workflow Opportunity Map with up to three ranked opportunities, one recommended first system, and a 14-day action plan.',
  },
  {
    question: 'What if the workflow is not worth automating?',
    answer: 'That is a useful outcome. The recommendation can be to implement, defer, simplify the process first, or stop—without forcing AI into work where it does not belong.',
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={homepageSchema} hideFooterNewsletter={true}>
  <section class="hero" data-homepage-hero aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <p class="eyebrow">Workflow automation for owner-operated teams</p>

      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Find the workflow worth fixing first.</h1>
          <p class="hero-lede">
            Bring one recurring workflow that wastes time or slows customers down. I’ll help you decide whether to automate it, improve the process first, or leave it alone.
          </p>

          <div class="hero-actions">
            <a class="btn btn-solid hero-primary" href={INTRO_CALL.href} data-analytics-event={ANALYTICS_EVENTS.bookingPageOpen} data-analytics-location="homepage-hero-booking">Bring me the stuck workflow <span aria-hidden="true">→</span></a>
            <a class="hero-secondary" href={SMB_ASSESSMENT.slug} data-analytics-event={ANALYTICS_EVENTS.smbAssessmentOpen} data-analytics-location="homepage-hero-assessment">See the $99 assessment</a>
          </div>

          <p class="hero-note">Start with a free 30-minute introduction. If the workflow is a fit, the assessment is the next step—not a required commitment.</p>
        </div>

        <aside class="offer-docket" aria-label="AI Workflow Opportunity Assessment">
          <p class="docket-name">$99 AI Workflow Opportunity Assessment</p>
          <h2>One workflow. A clear first move.</h2>
          <p class="docket-summary">A focused 60-minute working session for eligible owner-operators, followed by a concise Workflow Opportunity Map within 48 hours.</p>
          <dl class="docket-facts">
            <div><dt>01</dt><dd>Rank up to three opportunities</dd></div>
            <div><dt>02</dt><dd>Choose one first system</dd></div>
            <div><dt>03</dt><dd>Leave with a 14-day plan</dd></div>
          </dl>
          <a class="docket-link" href={SMB_ASSESSMENT.slug} data-analytics-event={ANALYTICS_EVENTS.smbAssessmentOpen} data-analytics-location="homepage-docket-assessment">Review the assessment →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="credibility-strip" aria-labelledby="credibility-title">
    <div class="wrap credibility-inner">
      <p id="credibility-title" class="credibility-label">Built &amp; shipped at</p>
      <div class="credibility-logos" role="list" aria-label="Organizations and products">
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/morningstar.svg" alt="Morningstar" class="credibility-logo" />
        </span>
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/ford.webp" alt="Ford Motor Company" class="credibility-logo credibility-ford" />
        </span>
        <span class="credibility-mark" role="listitem">
          <img src="/images/logos/finimbus.png" alt="FiNimbus" class="credibility-logo credibility-finimbus" />
        </span>
        <span class="credibility-mark credibility-connected" role="listitem">
          <span class="connected-icon" aria-hidden="true"></span>
          Connected Vehicle
        </span>
      </div>
      <p class="credibility-qualifier">Full-time employment and founder-owned product work, not consulting-client logos.</p>
    </div>
  </section>

  <section class="overview-section" id="services-overview" aria-labelledby="overview-title">
    <div class="wrap section-inner">
      <div class="section-intro">
        <p class="eyebrow">The recommended first step</p>
        <h2 id="overview-title">Decide before you build.</h2>
        <p>The assessment turns one recurring workflow into a bounded decision: implement, defer, simplify, or stop.</p>
      </div>

      <div class="assessment-ledger">
        <article><p class="offer-label">Session</p><h3>60 focused minutes</h3><p>Map the current workflow, its cost, constraints, and the outcome that would make a change worthwhile.</p></article>
        <article><p class="offer-label">Deliverable</p><h3>Within 48 hours</h3><p>Receive up to three ranked opportunities, one recommended first system, and a practical 14-day action plan.</p></article>
        <article><p class="offer-label">Boundary</p><h3>No forced implementation</h3><p>The answer may be implement, defer, improve the process first, or stop. Financial-services businesses are not eligible.</p></article>
      </div>
      <div class="overview-actions">
        <a class="btn btn-outline" href={SMB_ASSESSMENT.slug} data-analytics-event={ANALYTICS_EVENTS.smbAssessmentOpen} data-analytics-location="homepage-assessment-details">See assessment details →</a>
        <a href="/services">Need a different kind of help? See all services</a>
      </div>
    </div>
  </section>


  <section class="proof-band" aria-labelledby="proof-title">
      <div class="wrap section-inner" style="padding-block: clamp(48px, 6vw, 72px);">
          <div class="section-intro proof-intro" style="margin-bottom: 28px;">
            <p class="eyebrow">Selected outcomes</p>
            <h2 id="proof-title">Proof before promises.</h2>
            <p>Production results from full-time roles—not claims about consulting clients.</p>
          </div>
        <div class="proof-ledger">
          {proofItems.map(item => (
            <article><strong>{item.value}</strong><p>{item.detail}</p></article>
          ))}
        </div>
      </div>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="wrap section-inner faq-layout">
      <div>
        <p class="eyebrow">Before you book</p>
        <h2 id="faq-title">The practical questions.</h2>
        <p class="faq-intro">Eligibility, price, timing, and what you receive.</p>
      </div>

      <div class="faq-list">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="close-section" aria-labelledby="close-title">
    <div class="wrap close-inner close-inner--ledger">
      <div class="close-ledger-primary">
        <div>
          <p class="eyebrow">Next decision</p>
          <h2 id="close-title">Bring one workflow. We’ll name the right next step.</h2>
        </div>
        <a
          class="btn btn-solid close-ledger-button"
          href={INTRO_CALL.href}
          data-analytics-event={ANALYTICS_EVENTS.bookingPageOpen}
          data-analytics-location="homepage-final-booking"
        >
          {INTRO_CALL.bookingLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="close-actions close-ledger-secondary">
        <a
          class="close-secondary"
          href={SMB_ASSESSMENT.slug}
          data-analytics-event={ANALYTICS_EVENTS.smbAssessmentOpen}
          data-analytics-location="homepage-final-assessment"
        >
          See what the $99 assessment includes
        </a>
        <p class="close-note">One workflow, one grounded recommendation, and no pressure to implement.</p>
      </div>
    </div>
  </section>

  <section class="utility-section" aria-label="Secondary resources">
    <div class="wrap utility-grid">
      <article>
        <p class="eyebrow">Writing and tools</p>
        <a href="/articles">Practical guides for AI-assisted delivery →</a>
        <p>Articles and the Agent Harness Builder remain available without interrupting the offer.</p>
      </article>
      <article>
        <p class="eyebrow">{NEWSLETTER.name}</p>
        <a href="/newsletter">Get the next issue →</a>
        <p>{NEWSLETTER.promise}</p>
      </article>
      <article>
        <p class="eyebrow">Small-business automation</p>
        <a
          href={SMB_QUIZ.slug}
          data-analytics-event={ANALYTICS_EVENTS.smbQuizStart}
          data-analytics-location="homepage-footer-smb-quiz"
        >
          {SMB_QUIZ.ctaLabel} →
        </a>
        <p>Start here when the problem is operational drag rather than an engineering delivery path.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    margin: 0;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero,
  .credibility-strip,
  .overview-section,

  .proof-band,
  .faq-section,
  .utility-section {
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner > .eyebrow {
    max-width: 72ch;
    margin-bottom: clamp(22px, 3vw, 34px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, .82fr);
    gap: clamp(46px, 7vw, 88px);
    align-items: center;
  }

  .hero h1 {
    max-width: 13.5ch;
    margin: 0;
    font-size: clamp(48px, 5.4vw, 72px);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: .94;
    text-wrap: balance;
  }

  .hero h1 em {
    color: var(--accent-text);
    font-style: italic;
    font-weight: 500;
  }
  .hero-lede {
    max-width: 32rem;
    margin-top: 24px;
    color: var(--ink-soft);
    font-size: clamp(20px, 2vw, 25px);
    line-height: 1.38;
    text-wrap: pretty;
  }

  .hero-lede strong {
    color: var(--ink);
    font-weight: 500;
  }


  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 28px;
  }

  .hero-primary {
    min-height: 46px;
    padding-inline: 20px;
    font-weight: 500;
  }

  .hero-secondary,

  .close-secondary {
    font-family: var(--mono);
    font-size: 11px;
    text-underline-offset: 5px;
  }

  .hero-secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
  }

  .hero-secondary:hover {
    color: var(--accent-text);
  }

  .hero-note {
    max-width: 48ch;
    margin-top: 18px;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.55;
  }

  .offer-docket {
    position: relative;
    padding: clamp(26px, 3vw, 38px);
    border: 1px solid var(--ink);
    background: var(--paper-2);
    box-shadow: 12px 12px 0 var(--paper-3);
  }

  .offer-docket::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 62px;
    height: 4px;
    background: var(--accent);
    content: '';
  }


  .docket-name {
    margin: 0;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .offer-docket h2 {
    max-width: 13ch;
    margin-top: 6px;
    font-size: clamp(27px, 2.5vw, 36px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1;
  }

  .docket-summary {
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.5;
  }

  .docket-facts {
    margin-top: 23px;
    border-top: 1px solid var(--rule);
  }

  .docket-facts > div {
    display: grid;
    grid-template-columns: 75px 1fr;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--rule);
  }

  .docket-facts dt {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .docket-facts dd {
    color: var(--ink);
    font-size: 15px;
    line-height: 1.3;
  }

  .docket-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 12px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    text-underline-offset: 5px;
  }

  .docket-link:hover {
    color: var(--accent-text);
  }

  .credibility-inner {
    padding-block: 27px 24px;
  }

  .credibility-label,
  .credibility-qualifier {
    margin: 0;
    text-align: center;
    font-family: var(--mono);
  }

  .credibility-label {
    margin-bottom: 18px;
    color: var(--accent-text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .credibility-logos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(22px, 4vw, 58px);
    align-items: center;
  }

  .credibility-mark {
    display: flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    filter: grayscale(1) contrast(1.15);
    opacity: .82;
  }

  .credibility-logo {
    width: auto;
    max-width: 145px;
    height: 28px;
    object-fit: contain;
  }

  .credibility-ford {
    height: 34px;
  }

  .credibility-finimbus {
    height: 54px;
    mix-blend-mode: multiply;
  }

  .credibility-connected {
    gap: 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
  }

  .connected-icon {
    width: 14px;
    height: 14px;
    border: 1px dashed var(--accent-text);
    border-radius: 50%;
  }

  .credibility-qualifier {
    margin-top: 14px;
    color: var(--ink-faint);
    font-size: 11px;
    letter-spacing: .04em;
  }

  .section-inner {
    padding-block: clamp(66px, 9vw, 108px);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .78fr);
    gap: 24px clamp(42px, 7vw, 90px);
    align-items: end;
    margin-bottom: 42px;
  }

  .section-intro .eyebrow {
    grid-column: 1 / -1;
  }

  .section-intro h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(39px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: .96;
    text-wrap: balance;
  }

  .section-intro > p:last-child {
    margin: 0 0 4px;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.5;
    text-wrap: pretty;
  }



  .offer-label {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .assessment-ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--ink);
  }

  .assessment-ledger article {
    padding: clamp(24px, 3vw, 36px);
  }

  .assessment-ledger article + article {
    border-left: 1px solid var(--rule);
  }

  .assessment-ledger h3 {
    margin-top: 26px;
    font-size: clamp(24px, 2.2vw, 31px);
    font-weight: 500;
    line-height: 1.1;
  }

  .assessment-ledger article > p:last-child {
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.55;
  }

  .overview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 28px;
    align-items: center;
    margin-top: 28px;
  }

  .overview-actions > a:last-child {
    min-height: 44px;
    padding-block: 12px;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 11px;
    text-underline-offset: 5px;
  }

  .proof-ledger {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }


  .proof-ledger article + article {
    border-left: 1px solid var(--rule);
  }


  .proof-ledger p {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.45;
  }


  .faq-section {
    background: var(--paper-2);
  }



  .proof-ledger {
    border-block: 1px solid var(--ink);
  }

  .proof-ledger article {
    min-height: 180px;
    padding: 26px clamp(22px, 3vw, 34px);
  }

  .proof-ledger strong {
    display: block;
    color: var(--ink);
    font-size: clamp(27px, 3vw, 37px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1;
  }

  .proof-ledger p {
    margin-top: 16px;
  }

  .proof-qualifier {
    margin-top: 20px;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 11px;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(250px, .7fr) minmax(0, 1.3fr);
    gap: clamp(48px, 8vw, 110px);
  }

  .faq-section h2 {
    max-width: 11ch;
    margin-top: 12px;
    font-size: clamp(42px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: .96;
    text-wrap: balance;
  }

  .faq-intro {
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: 17px;
  }

  .faq-list {
    border-top: 1px solid var(--ink);
  }

  .faq-list details {
    border-bottom: 1px solid var(--rule);
  }

  .faq-list summary {
    position: relative;
    padding: 22px 42px 22px 0;
    cursor: pointer;
    font-size: 21px;
    font-weight: 500;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    position: absolute;
    right: 2px;
    font-family: var(--mono);
    content: '+';
  }

  .faq-list details[open] summary::after {
    content: '−';
  }

  .faq-list details p {
    max-width: 60ch;
    margin: -5px 0 23px;
    color: var(--ink-soft);
    font-size: 16px;
  }

  .close-section {
    border-bottom: 1px solid color-mix(in oklch, var(--paper) 20%, transparent);
    background: var(--ink);
    color: var(--paper);
  }

  .close-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px 80px;
    align-items: end;
    padding-block: clamp(48px, 6vw, 72px);
  }

  .close-section .eyebrow {
    color: color-mix(in oklch, var(--accent-btn) 86%, white);
  }

  .close-section h2 {
    max-width: 18ch;
    margin-top: 14px;
    font-size: clamp(28px, 3.5vw, 46px);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .close-actions {
    min-width: 310px;
  }

  .close-actions .btn {
    width: 100%;
    justify-content: center;
  }

  .close-secondary {
    display: block;
    margin-top: 18px;
    color: var(--paper);
    text-align: center;
  }

  .close-note {
    margin-top: 16px;
    color: color-mix(in oklch, var(--paper) 70%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    text-align: center;
  }

  .close-inner--ledger {
    grid-template-columns: 1fr;
  }

  .close-ledger-primary {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: end;
    padding-bottom: 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 28%, transparent);
  }

  .close-ledger-button {
    width: auto !important;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .close-ledger-secondary {
    display: flex;
    min-width: 0;
    max-width: none;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
  }

  .close-ledger-secondary .close-secondary,
  .close-ledger-secondary .close-note {
    margin-top: 0;
  }

  .close-ledger-secondary .close-secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-align: left;
  }

  .close-ledger-secondary .close-note {
    max-width: 52ch;
    text-align: right;
  }
  .utility-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block: 34px;
  }

  .utility-grid article {
    padding-inline: clamp(0px, 3vw, 34px);
  }

  .utility-grid article:first-child {
    padding-left: 0;
  }

  .utility-grid article + article {
    border-left: 1px solid var(--rule);
  }

