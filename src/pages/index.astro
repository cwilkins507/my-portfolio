---
import Layout from '../layouts/Layout.astro';
import { NEWSLETTER, ANALYTICS_EVENTS, PUBLIC_CONTACT_PROFILE } from '../data/site.js';
import { CATEGORIES } from '../data/categories.js';
import { articleFromModule } from '../utils/articleData.js';
import { getLatestIssues } from '../utils/newsletterIssues.js';

const pageTitle = 'Collin Wilkins — Software Engineering, Systems, and AI-Native Development';
const pageDescription = 'Essays and field notes on software engineering, distributed systems, infrastructure, developer tooling, and AI-native development.';

const articleModules = import.meta.glob('../articles/*.md', { eager: true });
const articles = Object.entries(articleModules)
  .map(([file, article]) => articleFromModule(file, article))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const bySlug = (slug) => articles.find(article => article.slug === slug);

// "Start here": the explainer leads, then the most-read pieces (Plausible top pages).
// Re-rank MOST_READ_SLUGS from analytics now and then; list order is display order.
const FEATURED_SLUG = 'ai-agent-harness';
const MOST_READ_SLUGS = [
  'best-ai-coding-harness-omp',
  'ai-code-review-best-practices-approaches-tools',
  'structured-output',
];
const featured = bySlug(FEATURED_SLUG);
const mostRead = MOST_READ_SLUGS.map(bySlug).filter(Boolean);

// Multi-part series collapse to one row in "Recent"; href points at the first part.
const SERIES = [
  {
    name: 'Company Brain',
    href: '/articles/github-repository-ai-knowledge-base',
    slugs: [
      'github-repository-ai-knowledge-base',
      'managed-rag-aws-bedrock-knowledge-base',
      'onenote-microsoft-365-copilot-knowledge-base',
      'markdown-vault-ai-context-layer',
    ],
  },
];

const shownSlugs = new Set([FEATURED_SLUG, ...MOST_READ_SLUGS]);
const recentRows = [];
const seenSeries = new Set();
for (const article of articles) {
  if (recentRows.length === 5) break;
  if (shownSlugs.has(article.slug)) continue;
  const series = SERIES.find(entry => entry.slugs.includes(article.slug));
  if (series) {
    if (seenSeries.has(series.name)) continue;
    seenSeries.add(series.name);
    recentRows.push({ title: `${series.name} series`, note: `${series.slugs.length} parts`, href: series.href, date: article.date });
  } else {
    recentRows.push({ title: article.title, note: article.category, href: `/articles/${article.slug}`, date: article.date });
  }
}

const issues = await getLatestIssues(3);
const latestIssue = issues[0];

const freeResource = {
  name: 'AI Prompt Toolkit',
  pitch: '32 AI prompts I use for engineering work',
  description: 'Code review, debugging, architecture, documentation, and planning prompts, written out in full rather than summarized. Free, no email required.',
  href: '/resources/ai-prompt-toolkit',
  cta: 'Open the toolkit',
};

const topicCounts = Object.keys(CATEGORIES).map(name => ({
  name,
  href: `/articles?cat=${encodeURIComponent(name)}`,
  count: articles.filter(article => article.category === name).length,
})).filter(topic => topic.count > 0);

const projects = [
  {
    name: 'Agent Harness Builder',
    kind: 'Tool',
    description: 'Generates the repository scaffolding a coding agent needs to be useful: conventions, protected paths, verification hooks, and a reviewable change path.',
    href: '/resources/agent-harness-builder',
  },
  {
    name: 'Ask the archive',
    kind: 'Experiment',
    description: 'Retrieval over every article on this site — a small Python RAG service with its own corpus, rate limiting, and evaluation harness.',
    href: '/ask',
  },
  {
    name: 'FiNimbus',
    kind: 'Personal project',
    description: 'A founder-owned financial software project, built and operated outside of any employer. Written up from the inside: automating its signup flow over a weekend.',
    href: '/articles/automate-saas-signup-flow-weekend',
  },
];

const formatDate = (value) =>
  new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Collin Wilkins',
    url: 'https://collinwilkins.com',
    description: pageDescription,
    author: {
      '@type': 'Person',
      name: 'Collin Wilkins',
      jobTitle: 'Software Engineer',
      url: 'https://collinwilkins.com/about',
      sameAs: [PUBLIC_CONTACT_PROFILE.github, PUBLIC_CONTACT_PROFILE.x],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: NEWSLETTER.name,
    url: 'https://collinwilkins.com/articles',
    description: pageDescription,
    blogPost: articles.slice(0, 4).map(article => ({
      '@type': 'BlogPosting',
      headline: article.title,
      url: `https://collinwilkins.com/articles/${article.slug}`,
      datePublished: article.date,
    })),
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={homepageSchema} hideFooterNewsletter={true}>
  <!-- 1. Newsletter first -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title">Notes on building software that has to survive production.</h1>
      <p class="hero-lede">
        {NEWSLETTER.name}: what AI-assisted engineering looks like once it meets production —
        agent harnesses, code review, the context layer — from an engineer who still thinks in
        distributed systems. Sent when there's something worth sending.
      </p>
      <form
        action={NEWSLETTER.subscribeAction}
        method="post"
        target="popupwindow"
        data-newsletter-event={ANALYTICS_EVENTS.newsletterSubscribe}
        data-location="homepage-hero"
        class="subscribe-form hero-form"
      >
        <label class="sr-only" for="hero-newsletter-email">Email address</label>
        <input
          id="hero-newsletter-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button type="submit" class="btn btn-solid">Subscribe free</button>
      </form>
      <p class="form-note">Sent through Buttondown. Every past letter is public.</p>
      {latestIssue && (
        <a class="latest-letter" href={latestIssue.href}>
          <span class="latest-label">Latest letter</span>
          <span class="latest-title">{latestIssue.title}</span>
          <time datetime={latestIssue.date}>{formatDate(latestIssue.date)}</time>
        </a>
      )}
    </div>
  </section>

  <!-- 2. Free resource -->
  <section class="band resource" aria-labelledby="resource-title">
    <div class="wrap resource-inner">
      <p class="resource-kind">{freeResource.name}</p>
      <div>
        <h2 id="resource-title">{freeResource.pitch}</h2>
        <p class="resource-desc">{freeResource.description}</p>
      </div>
      <a class="btn btn-ghost resource-cta" href={freeResource.href}>{freeResource.cta} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 3. Start here: explainer first, then most read -->
  {featured && (
    <section id="start" class="band" aria-labelledby="start-title">
      <div class="wrap">
        <div class="section-head ruled">
          <h2 id="start-title">Start here</h2>
        </div>
        <a class="start-lead" href={`/articles/${featured.slug}`}>
          <span class="essay-cat">The explainer</span>
          <span class="start-lead-body">
            <span class="start-lead-title">{featured.title}</span>
            <span class="essay-dek">{featured.excerpt}</span>
          </span>
        </a>
        {mostRead.length > 0 && (
          <>
            <p class="list-label">Most read</p>
            <ul class="row-list dated">
              {mostRead.map(article => (
                <li>
                  <a href={`/articles/${article.slug}`}>
                    <time datetime={article.date}>{formatDate(article.date)}</time>
                    <span class="row-title">{article.title}</span>
                    <span class="row-meta">{article.category}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <!-- 4. Recent -->
  <section class="band" aria-labelledby="recent-title">
    <div class="wrap">
      <div class="section-head ruled">
        <h2 id="recent-title">Recent</h2>
      </div>
      <ul class="row-list dated">
        {recentRows.map(row => (
          <li>
            <a href={row.href}>
              <time datetime={row.date}>{formatDate(row.date)}</time>
              <span class="row-title">{row.title}</span>
              <span class="row-meta">{row.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="archive-link" href="/articles">View all {articles.length} articles <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="band" aria-labelledby="topics-title">
    <div class="wrap">
      <div class="section-head ruled">
        <h2 id="topics-title">By topic</h2>
      </div>
      <ul class="row-list dated">
        {topicCounts.map(topic => (
          <li>
            <a href={topic.href}>
              <span class="row-meta">{topic.count} {topic.count === 1 ? 'article' : 'articles'}</span>
              <span class="row-title">{topic.name}</span>
              <span class="row-meta" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head ruled">
        <h2 id="projects-title">Projects &amp; experiments</h2>
      </div>
      <ul class="row-list dated">
        {projects.map(project => (
          <li>
            <a href={project.href}>
              <span class="row-meta">{project.kind}</span>
              <span class="row-body">
                <span class="row-title">{project.name}</span>
                <span class="row-desc">{project.description}</span>
              </span>
              <span class="row-meta" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. About -->
  <section class="band about" aria-labelledby="about-title">
    <div class="wrap about-inner">
      <img
        class="about-portrait"
        src="/images/profile_photo.webp"
        alt="Collin Wilkins"
        width="128"
        height="128"
        loading="lazy"
        decoding="async"
      />
      <div class="about-copy">
        <h2 id="about-title">Hey, I'm Collin.</h2>
        <p>
          I'm a software engineer. My work centers on distributed and event-driven systems, cloud
          infrastructure, and the developer tooling that decides whether a team can change its own
          software safely. Most of what I publish starts as something I had to figure out anyway — a
          system that behaved strangely under load, a workflow that only worked because one person
          remembered the trick, an agent that looked productive until someone reviewed the diff.
        </p>
        <p>
          I came to engineering by way of finance, pricing, and operations, which is why I still start
          with the boring numbers before the architecture diagram. <a href="/about">More about me →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Newsletter again, with the letters themselves -->
  <section id="subscribe" class="band subscribe" aria-labelledby="subscribe-title">
    <div class="wrap subscribe-inner">
      <div>
        <h2 id="subscribe-title">One letter, no fixed schedule.</h2>
        <p class="subscribe-promise">{NEWSLETTER.promise}</p>
        <form
          action={NEWSLETTER.subscribeAction}
          method="post"
          target="popupwindow"
          data-newsletter-event={ANALYTICS_EVENTS.newsletterSubscribe}
          data-location="homepage"
          class="subscribe-form"
        >
          <label class="sr-only" for="homepage-newsletter-email">Email address</label>
          <input
            id="homepage-newsletter-email"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="btn btn-solid">Subscribe free</button>
        </form>
        <p class="form-note">Sent through Buttondown. Every past letter is public.</p>
      </div>
      {issues.length > 0 && (
        <div class="letters">
          <p class="list-label">Recent letters</p>
          <ul class="row-list dated">
            {issues.map(issue => (
              <li>
                <a href={issue.href}>
                  <time datetime={issue.date}>{formatDate(issue.date)}</time>
                  <span class="row-title">{issue.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="archive-link" href={NEWSLETTER.archiveHref}>All past letters <span aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .hero {
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner {
    padding-top: clamp(64px, 9vw, 128px);
    padding-bottom: clamp(52px, 7vw, 96px);
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 52rem);
    column-gap: 24px;
  }

  .hero-inner > *,
  .section-head > *,
  .subscribe-inner > :first-child {
    grid-column: 2;
  }

  h1 {
    font-size: clamp(38px, 6vw, 68px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -.022em;
    text-wrap: balance;
    max-width: 18ch;
  }

  .hero-lede {
    margin-top: 22px;
    max-width: 50ch;
    font-size: clamp(18px, 2.1vw, 21px);
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .hero-form {
    margin-top: 32px;
    max-width: 32rem;
  }

  .form-note {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-faint);
  }

  .latest-letter {
    display: inline-grid;
    grid-template-columns: auto auto auto;
    align-items: baseline;
    gap: 4px 14px;
    justify-self: start;
    min-height: 44px;
    margin-top: 22px;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .latest-label,
  .latest-letter time {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .latest-title {
    font-size: 19px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 5px;
  }

  .latest-letter:hover .latest-title {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 620px) {
    .latest-letter { grid-template-columns: 1fr; }
  }

  .band {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(48px, 6.5vw, 84px);
  }

  .section-head {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .section-head.ruled {
    border-bottom-color: var(--ink);
  }

  .section-head h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.018em;
  }


  /* ── Free resource ── */
  .resource {
    background: var(--paper-2);
  }

  .resource-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) auto;
    gap: 16px 24px;
    align-items: center;
  }

  .resource-kind {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .resource h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.015em;
  }

  .resource-desc {
    margin-top: 8px;
    max-width: 58ch;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 620px) {
    .resource-inner { grid-template-columns: 1fr; }
    .resource-cta { justify-self: start; }
  }

  /* ── Start here + Recent ── */
  .start-lead {
    display: grid;
    gap: 10px 24px;
    align-items: baseline;
    padding: clamp(24px, 3vw, 34px) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .essay-cat,
  .list-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .list-label {
    margin-top: clamp(28px, 3.4vw, 40px);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .start-lead-title {
    max-width: 24ch;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .start-lead:hover .start-lead-title {
    color: var(--accent-text);
  }

  .essay-dek {
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .row-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row-list li + li {
    border-top: 1px solid var(--rule);
  }

  .row-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 24px;
    align-items: baseline;
    min-height: 44px;
    padding: 16px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .row-list.dated a,
  .start-lead {
    grid-template-columns: var(--rail) minmax(0, 1fr) auto;
  }

  .row-body,
  .start-lead-body {
    display: grid;
    gap: 6px;
  }

  .row-desc {
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .row-list time,
  .row-meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .row-title {
    font-size: clamp(19px, 2vw, 22px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    text-wrap: balance;
  }

  .row-list a:hover .row-title {
    color: var(--accent-text);
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .archive-link:hover {
    color: var(--accent-text);
  }

  @media (max-width: 620px) {
    .row-list a,
    .row-list.dated a,
    .start-lead { grid-template-columns: 1fr; gap: 4px; }
    .row-list a > [aria-hidden="true"] { display: none; }
    .hero-inner,
    .section-head,
    .subscribe-inner { grid-template-columns: 1fr; }
    .hero-inner > *,
    .section-head > *,
    .subscribe-inner > * { grid-column: 1; }
  }

  /* ── About ── */
  .about-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .about-portrait {
    width: clamp(96px, 11vw, 128px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .about h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.018em;
  }

  .about-copy p {
    margin-top: 16px;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .about-copy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .about-inner { grid-template-columns: 1fr; }
  }

  /* ── Closing subscribe ── */
  .subscribe {
    background: var(--paper-2);
    border-bottom: none;
  }

  .subscribe-inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 64px) 24px;
  }

  .subscribe-inner > .letters {
    grid-column: 1 / -1;
  }

  .letters .list-label {
    margin-top: 0;
  }


  .subscribe h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.018em;
  }

  .subscribe-promise {
    margin-top: 14px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .subscribe .subscribe-form {
    margin-top: 24px;
    max-width: 32rem;
  }

  /* ── Shared form ── */
  .subscribe-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .subscribe-form input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 12px 18px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
  }

  .subscribe-form input:focus-visible {
    border-color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
