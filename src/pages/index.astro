---
import Layout from '../layouts/Layout.astro';
import { ENGINEERING_PILOT, SMB_ASSESSMENT, NEWSLETTER } from '../data/site.js';
---
<Layout title="AI-Assisted Delivery Pilot | Collin Wilkins" description={ENGINEERING_PILOT.description} hideFooterNewsletter={true}>
<section class="hero wrap"><p class="eyebrow">For {ENGINEERING_PILOT.audience.toLowerCase()}</p><h1>{ENGINEERING_PILOT.lead}</h1><p class="lede">{ENGINEERING_PILOT.description}</p><p class="contract">{ENGINEERING_PILOT.priceLabel} · {ENGINEERING_PILOT.deliveryWindow} · {ENGINEERING_PILOT.deliveryMode}</p><div class="actions"><a class="btn btn-primary" href={ENGINEERING_PILOT.intakeHref}>{ENGINEERING_PILOT.intakeLabel}</a><a class="btn btn-ghost" href={ENGINEERING_PILOT.fitCallHref}>{ENGINEERING_PILOT.fitCallLabel}</a></div></section>
<section class="signature"><div class="wrap pipeline"><span>approved issue</span><b>→</b><span>bounded agent</span><b>→</b><span>draft PR</span><b>→</b><span>CI</span><b>→</b><span>human approval</span></div></section>
<section class="wrap block"><p class="eyebrow">Selected employment proof</p><h2>Production engineering, with the context kept intact.</h2><p class="qualifier">Outcomes from full-time engineering roles, not consulting clients.</p><div class="proof"><p><strong>450K+ vehicles</strong><br/>Ford work associated with approximately $5M in annual savings.</p><p><strong>600K+ events/day</strong><br/>Connected-vehicle systems at production scale.</p><p><strong>23+ recordkeepers</strong><br/>Secure AWS service delivery.</p><p><strong>42% fewer defects</strong><br/>A broader AI-adoption and delivery-hardening initiative also associated with approximately 20% shorter cycle time.</p></div></section>
<section class="wrap block"><p class="eyebrow">What the pilot installs</p><h2>A governed path inside the repository you already use.</h2><div class="proof"><p>Structured intake and repository context</p><p>Protected paths and human-only boundaries</p><p>Existing verification and optional read-only review</p><p>Visible model configuration and usage evidence</p></div><div class="actions"><a href={ENGINEERING_PILOT.capabilityBriefHref}>View the capability brief →</a><a href={ENGINEERING_PILOT.slug}>Read the complete offer →</a></div></section>
<section class="wrap block"><p class="eyebrow">Selected writing and resources</p><h2>Field notes from production work.</h2><ul class="links"><li><a href="/articles/managing-engineering-teams-with-ai">Managing Engineering Teams With AI</a></li><li><a href="/articles/context-engineering-ai-coding-tools">Context Engineering for AI Coding Tools</a></li><li><a href="/resources/agent-harness-builder">Agent Harness Builder</a></li><li><a href="/articles">Browse all articles</a></li></ul></section>
<section class="notes"><div class="wrap"><p class="eyebrow">{NEWSLETTER.name}</p><h2>{NEWSLETTER.promise}</h2><p>{NEWSLETTER.cadence}. Subscription events measure intent because Buttondown confirmation is cross-origin.</p><form action={NEWSLETTER.subscribeAction} method="post" target="popupwindow"><label>Email address<input type="email" name="email" required placeholder="you@company.com"/></label><button class="btn btn-primary">Subscribe</button></form><a href={NEWSLETTER.archiveHref}>Read the archive →</a></div></section>
<section class="wrap smb"><p class="eyebrow">Small-business automation</p><h2>Not leading an engineering team?</h2><p>The separate {SMB_ASSESSMENT.name} helps owners and operators choose one recurring workflow worth improving.</p><a href={SMB_ASSESSMENT.slug}>View the $99 assessment →</a></section>
</Layout>
<style>.hero{padding-top:clamp(90px,13vw,160px);padding-bottom:60px;max-width:1050px}.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}h1{font-size:clamp(46px,8vw,88px);line-height:.94;max-width:13ch;margin:18px 0}.lede{font-size:clamp(20px,2.4vw,28px);max-width:68ch;color:var(--ink-soft)}.contract{font-family:var(--mono);font-size:13px;margin-top:25px}.actions{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:28px}.signature,.notes{background:var(--paper-2);border-block:1px solid var(--rule)}.pipeline{display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding-block:20px;font-family:var(--mono);font-size:12px}.pipeline span{padding:9px 12px;border:1px solid var(--rule);background:var(--paper)}.block,.smb{padding-block:clamp(60px,8vw,100px);border-bottom:1px solid var(--rule)}h2{font-size:clamp(32px,5vw,54px);max-width:20ch;margin:12px 0 25px}.qualifier{font-style:italic}.proof{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule)}.proof p{background:var(--paper);margin:0;padding:24px}.links{font-size:20px;line-height:2}.notes{padding-block:70px}.notes form{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:24px 0}.notes label{display:grid;gap:7px;font-family:var(--mono);font-size:11px}.notes input{padding:12px 15px;border:1px solid var(--rule);background:var(--paper);font-size:16px;min-width:270px}.smb{max-width:820px}@media(max-width:620px){.proof{grid-template-columns:1fr}h1{overflow-wrap:anywhere}}</style>
