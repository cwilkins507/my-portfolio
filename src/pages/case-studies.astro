---
import Layout from '../layouts/Layout.astro';
import CaseStudies from '../components/CaseStudies';

const caseStudiesSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": "Selected work | Collin Wilkins",
	"description": "A record of prior engineering work: IoT telemetry and connected-vehicle systems, event-driven compliance architecture, and privacy-first theft recovery for the 2024 F-150.",
	"url": "https://collinwilkins.com/case-studies",
	"author": {
		"@type": "Person",
		"name": "Collin Wilkins"
	}
};
---

<Layout
	title="Selected work | Collin Wilkins"
	description="A record of prior engineering work: IoT telemetry and connected-vehicle systems, event-driven compliance architecture, and privacy-first theft recovery for the 2024 F-150."
	schema={caseStudiesSchema}
>
	<CaseStudies />
</Layout>
