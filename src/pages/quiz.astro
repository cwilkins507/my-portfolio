---
import Layout from '../layouts/Layout.astro';
import Quiz from '../components/Quiz';
import { SITE_URL, SMB_ASSESSMENT, SMB_QUIZ } from '../data/site.js';

const pageTitle = `${SMB_QUIZ.name} | Collin Wilkins`;
const pageDescription = `${SMB_QUIZ.description} No booking or payment is created; the separate $${SMB_ASSESSMENT.priceUsd} ${SMB_ASSESSMENT.name} remains the structured next step.`;
const quizSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: SMB_QUIZ.name,
	description: pageDescription,
	url: `${SITE_URL}${SMB_QUIZ.slug}`,
	audience: {
		'@type': 'Audience',
		audienceType: SMB_ASSESSMENT.audience,
	},
	author: {
		'@type': 'Person',
		name: 'Collin Wilkins',
		url: 'https://collinwilkins.com/about',
	},
};
---

<Layout title={pageTitle} description={pageDescription} schema={quizSchema} hideFooterNewsletter={true}>
	<Quiz client:load />
</Layout>
