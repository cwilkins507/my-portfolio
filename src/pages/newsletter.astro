---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<Layout title="Notes from Production | Collin Wilkins" description="One field note every other Tuesday for engineering leaders turning AI coding tools into repeatable team practice." hideFooterNewsletter={true}>
	<section class="max-w-[960px] mx-auto px-6 pt-32 pb-20">
		<div class="max-w-2xl mx-auto text-center mb-12">
			<h1 class="text-4xl md:text-5xl font-serif font-bold text-[var(--color-text-primary)] mb-4">Notes from Production</h1>
			<p class="text-lg text-moonlight-text-secondary leading-relaxed">
				One field note every other Tuesday for engineering leaders turning AI coding tools into repeatable team practice.
			</p>
		</div>

		<div class="max-w-xl mx-auto">
			<NewsletterSignup variant="inline" location="newsletter-page" />
		</div>

		<div class="text-center mt-12">
			<a
				href="https://buttondown.com/collinwilkins/archive/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm text-moonlight-text-muted hover:text-[var(--color-accent)] underline underline-offset-4 decoration-transparent hover:decoration-[var(--color-accent)] transition-all duration-300"
			>
				Read past issues →
			</a>
		</div>
	</section>
</Layout>
