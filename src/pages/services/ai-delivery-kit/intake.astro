---
import Layout from '../../../layouts/Layout.astro';
import PilotIntakeForm from '../../../components/PilotIntakeForm.jsx';
import { ENGINEERING_PILOT } from '../../../data/site.js';
---
<Layout title={`Pilot intake | ${ENGINEERING_PILOT.name}`} description="Request a no-payment fit and scope review for the AI-Assisted Delivery Pilot." hideFooterNewsletter={true}>
  <article class="wrap intake"><header><p class="eyebrow">No-payment fit review</p><h1>Start with the issue, repository, and human owner.</h1><p>Share enough context to determine whether one approved issue fits the {ENGINEERING_PILOT.priceLabel} pilot. Scope acceptance and payment happen only after review.</p></header><PilotIntakeForm client:load /></article>
</Layout>
<style>.intake{max-width:780px;padding-top:clamp(70px,10vw,120px);padding-bottom:90px}.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}h1{font-size:clamp(40px,6vw,68px);line-height:1;margin:16px 0 22px}.intake-form{display:grid;gap:20px;margin-top:42px}.intake-form label{display:grid;gap:8px;font-family:var(--mono);font-size:12px}.intake-form input,.intake-form textarea,.intake-form select{font:16px Newsreader,serif;color:var(--ink);background:var(--paper);border:1px solid var(--rule);border-radius:4px;padding:13px;width:100%}.intake-form input:focus,.intake-form textarea:focus,.intake-form select:focus{outline:3px solid color-mix(in srgb,var(--accent) 35%,transparent);border-color:var(--accent)}.disclosure{font-size:15px;color:var(--ink-soft)}.error{color:#8a1c1c}.intake-success{margin-top:42px;padding:28px;border:1px solid var(--accent);background:var(--paper-2)}</style>
