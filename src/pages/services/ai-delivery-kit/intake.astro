---
import Layout from '../../../layouts/Layout.astro';
import PilotIntakeForm from '../../../components/PilotIntakeForm.jsx';
import { ENGINEERING_PILOT } from '../../../data/site.js';
---
<Layout title={`Pilot intake | ${ENGINEERING_PILOT.name}`} description="Request a no-payment fit and scope review for the AI-Assisted Delivery Pilot." hideFooterNewsletter={true}>
  <article class="wrap intake">
    <header>
      <p class="eyebrow">No-payment scope review</p>
      <h1>Start with the issue, repository, and accountable reviewers.</h1>
      <p>Share enough context for a preliminary fit and scope review. If it fits, you receive a written scope, acceptance checklist, and start decision before paying the $500 first installment.</p>
    </header>
    <section class="preflight" aria-labelledby="preflight-title">
      <div><p class="eyebrow">Before the 14 required fields</p><h2 id="preflight-title">Use direct intake when these four facts are ready.</h2></div>
      <ul><li>One approved, low-risk backlog issue</li><li>A working repository, verification baseline, CI, and draft-PR branch protection</li><li>A named technical owner and reviewer</li><li>A selected coding tool with an agent-access plan</li></ul>
      <p>Not ready on one of these? <a href={ENGINEERING_PILOT.fitCallHref}>Book the optional free 30-minute intro</a> or <a href={ENGINEERING_PILOT.slug}>review the full readiness gate</a>. Do not invent an answer to continue.</p>
    </section>
    <PilotIntakeForm client:load />
  </article>
</Layout>
<style>.intake{max-width:780px;padding-top:clamp(70px,10vw,120px);padding-bottom:90px}.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-text)}h1{font-size:clamp(40px,6vw,68px);line-height:1;margin:16px 0 22px}:global(.intake-form){display:grid;gap:20px;margin-top:42px}:global(.intake-form label){display:grid;gap:8px;font-family:var(--mono);font-size:12px}:global(.intake-form input),:global(.intake-form textarea),:global(.intake-form select){font:16px Newsreader,serif;color:var(--ink);background:var(--paper);border:1px solid var(--rule);padding:12px}:global(.intake-form textarea){resize:vertical}:global(.disclosure){font-size:14px;color:var(--ink-soft)}:global(.error){color:#a33}:global(.intake-success){margin-top:40px;padding:30px;border:1px solid var(--accent);background:var(--paper-2)}</style>
<style>
  .preflight { margin-top: 36px; padding: 24px; border: 1px solid var(--rule); background: var(--paper-2); }
  .preflight h2 { margin: 8px 0 16px; font-size: clamp(24px, 4vw, 34px); }
  .preflight ul { padding-left: 20px; }
  .preflight li { margin: 8px 0; }
  .preflight a, :global(.intake-form a), :global(.intake-success a) { display: inline-flex; min-height: 44px; align-items: center; color: var(--accent-text); font-weight: 600; }
  :global(.intake-form) { margin-top: 32px; }
  :global(.intake-form fieldset) { display: grid; gap: 18px; margin: 0; padding: 24px 0 32px; border: 0; border-top: 1px solid var(--rule); }
  :global(.intake-form legend) { padding: 0 12px 0 0; font-family: var(--serif); font-size: 26px; font-weight: 600; }
  :global(.group-description), :global(.required-note) { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.5; }
  :global(.data-notice) { padding: 20px; border-left: 3px solid var(--accent); background: var(--paper-2); color: var(--ink-soft); font-size: 14px; line-height: 1.5; }
  :global(.data-notice p) { margin: 8px 0 0; }
  :global(.error) { padding: 16px; border-left: 3px solid var(--error, #8a2f2f); background: var(--paper-2); }
  :global(.intake-form button) { min-height: 44px; }
  :global(.form-routes) { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  :global(.intake-success:focus), :global(.error:focus) { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 520px) {
    .intake { padding-top: 48px; }
    .preflight { padding: 18px; }
  }
</style>
